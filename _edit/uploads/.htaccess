# Never execute uploads, including files created before MIME-derived naming.
Options -Indexes -ExecCGI -Includes -FollowSymLinks
SetHandler default-handler
RewriteEngine Off
Require all denied
<FilesMatch "^[^.]+\.(jpg|jpeg|png|gif|webp|pdf|doc|docx|xls|xlsx|mp4|webm|ogg|oga|mp3|wav)$">
    Require all granted
    SetHandler default-handler
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "sandbox; default-src 'none'"
</IfModule>
<IfModule mod_mime.c>
    AddType image/jpeg .jpg .jpeg
    AddType image/png .png
    AddType image/gif .gif
    AddType image/webp .webp
    AddType application/pdf .pdf
    AddType application/msword .doc
    AddType application/vnd.openxmlformats-officedocument.wordprocessingml.document .docx
    AddType application/vnd.ms-excel .xls
    AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet .xlsx
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType video/ogg .ogg
    AddType audio/ogg .oga
    AddType audio/mpeg .mp3
    AddType audio/wav .wav
</IfModule>
