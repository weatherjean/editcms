# Enable rewriting
RewriteEngine On
RewriteBase /_edit

# Protect sensitive directories
RewriteRule ^database/ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule ^core/ - [F,L]

# Protect sensitive files
<FilesMatch "(\.sqlite|\.txt|\.log|\.env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# API routes - route to api/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# Admin routes - serve admin files
RewriteCond %{REQUEST_URI} ^/_edit/admin/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/(.*)$ admin/index.html [L]

# Allow uploads directory
RewriteCond %{REQUEST_URI} ^/_edit/uploads/
RewriteRule ^uploads/ - [L]

# Default route - redirect to admin
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ index.php [L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
