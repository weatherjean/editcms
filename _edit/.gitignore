# Development Vue source (excluded from distribution)
admin-source/node_modules/
admin-source/.vite/

# Prevent dev artifacts in production admin folder
admin/.vite/

# User data - never commit
data/database/*.sqlite
data/database/*.db
data/database/*.sqlite-journal
data/database/*.sqlite-wal
data/database/*.sqlite-shm

# User uploads - never commit
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# Config backups - auto-generated
data/config/backups/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
error.log
access.log

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-*

# Temporary files
*.tmp
*.temp
*.bak
*.old
*.cache

# Security - JWT secret now stored in database, but keep this for old installs
config/jwt-secret.txt

# PHP
vendor/
composer.lock
