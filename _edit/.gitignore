# Dependencies
admin/node_modules/

# Build output (tracked - this is what gets deployed)
# admin-dist/ should be committed for production

# Development build artifacts
admin/dist/

# Database - never commit production data
database/*.sqlite
database/*.db
database/*.sqlite-journal
database/*.sqlite-wal
database/*.sqlite-shm

# Environment files
.env
.env.local
.env.*.local

# Config backups - auto-generated
config/backups/

# Uploads - user content, not tracked
uploads/*
!uploads/.gitkeep
!uploads/**/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
error.log
access.log

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-*

# Temporary files
*.tmp
*.temp
*.bak
*.old
*.cache

# Security - JWT secret now stored in database, but keep this for old installs
config/jwt-secret.txt

# PHP
vendor/
composer.lock
